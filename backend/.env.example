# Copy this file to .env and fill in your real values. Never commit .env itself.

DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Optional: only needed if you want the agent to write more natural-language
# recommendation text via Claude. Without this, the system still works fully
# using the built-in templated explanations.
ANTHROPIC_API_KEY=
